{
  "name": "@local/dsh-suishi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "岁时 · 中国年 · 全年节日倒计时：DSH Web 全屏年历面板，含农历、二十四节气、自定义纪念日与春节倒计时胶囊。",
  "icon": "./icon.svg",
  "author": "dsh-suishi",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianniu2009/dsh-suishi.git"
  },
  "homepage": "https://github.com/qianniu2009/dsh-suishi",
  "bugs": {
    "url": "https://github.com/qianniu2009/dsh-suishi/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "suishi",
    "lunar-calendar",
    "solar-terms",
    "chinese-calendar",
    "countdown"
  ]
}
